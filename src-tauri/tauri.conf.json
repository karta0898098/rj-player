{
  "productName": "rj-player",
  "version": "0.1.0",
  "identifier": "io.github.karta0898098.rjplayer",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "bash src-tauri/binaries/fetch-sidecars.sh && npm --prefix frontend run build",
    "beforeBuildCommand": "bash src-tauri/binaries/fetch-sidecars.sh && npm --prefix frontend run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "resources": {
      "../frontend/dist": "frontend/dist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
